---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublications, getCollaborators } from '@/lib/bib';
import { talks } from '@/data/research';
import { APPLICATIONS, FIELDS } from '@/lib/taxonomy';
import collaborators from '@/data/collaborators.json';
import metrics from '@/data/metrics.json';

type LinkInfo = { name: string; url?: string; affiliation?: string };
const links = collaborators as Record<string, LinkInfo>;

// Graph colours follow the application (src/lib/taxonomy.ts). Each co-author is
// coloured by the applications of the papers shared with Elia, as pie slices when several.
const TOPICS = APPLICATIONS;

const pubs = getPublications();
const collabs = getCollaborators();
const years = pubs.map((p) => p.year).filter((y) => y > 0);
const yearMin = Math.min(...years);
const yearMax = Math.max(...years);

const stats = [
  { label: 'Contributions', value: String(pubs.length) },
  { label: 'Journal articles', value: String(pubs.filter((p) => p.pubType === 'journal').length) },
  { label: 'Co-authors', value: String(collabs.length) },
  { label: 'Talks & seminars', value: String(talks.length) },
  { label: 'Years active', value: `${yearMin}–${yearMax}` },
];

// ── build the co-authorship graph (nodes + weighted edges) ──
interface Share { id: string; w: number; }
interface GNode { id: string; name: string; count: number; elia: boolean; url?: string; topic?: string; shares?: Share[]; }
const nodeMap = new Map<string, GNode>();
nodeMap.set('__elia', { id: '__elia', name: 'Elia Onofri', count: pubs.length, elia: true });
const linkMap = new Map<string, number>();
const appWeights = new Map<string, Map<string, number>>();

for (const p of pubs) {
  const ids = ['__elia'];
  for (const a of p.authors) {
    if (a.isElia) continue;
    if (!nodeMap.has(a.slug)) {
      const info = links[a.slug];
      nodeMap.set(a.slug, { id: a.slug, name: a.display, count: 0, elia: false, url: info?.url || undefined });
    }
    nodeMap.get(a.slug)!.count++;
    ids.push(a.slug);
    const aw = appWeights.get(a.slug) ?? new Map<string, number>();
    for (const x of p.cls.apps) aw.set(x, (aw.get(x) ?? 0) + 1 / p.cls.apps.length);
    appWeights.set(a.slug, aw);
  }
  for (let i = 0; i < ids.length; i++)
    for (let j = i + 1; j < ids.length; j++) {
      const key = [ids[i], ids[j]].sort().join('::');
      linkMap.set(key, (linkMap.get(key) || 0) + 1);
    }
}
const appOrder = APPLICATIONS.map((x) => x.id);
for (const n of nodeMap.values()) {
  if (n.elia) continue;
  const aw = appWeights.get(n.id);
  const total = aw ? [...aw.values()].reduce((x, y) => x + y, 0) : 0;
  if (aw && total > 0) {
    n.shares = [...aw.entries()]
      .map(([id, w]) => ({ id, w: w / total }))
      .sort((x, y) => appOrder.indexOf(x.id) - appOrder.indexOf(y.id));
    n.topic = [...n.shares].sort((x, y) => y.w - x.w)[0].id;
  }
}
const graph = {
  nodes: [...nodeMap.values()],
  links: [...linkMap.entries()].map(([k, weight]) => {
    const [source, target] = k.split('::');
    return { source, target, weight };
  }),
};

const top = collabs.slice(0, 10).map((c) => ({ ...c, url: links[c.slug]?.url, aff: links[c.slug]?.affiliation }));

// ── collab details for the modal ──────────────────────────────────────────
interface SharedPub { title: string; year: number; links: { label: string; href: string }[]; }
interface FacetCount { id: string; label: string; n: number; }
interface CollabDetail {
  name: string; url?: string; affiliation?: string; pubs: SharedPub[];
  fields: FacetCount[]; apps: FacetCount[];   // shared papers per field / application
}
const collabDetails: Record<string, CollabDetail> = {};
for (const p of pubs) {
  for (const a of p.authors) {
    if (a.isElia) continue;
    if (!collabDetails[a.slug]) {
      const info = links[a.slug];
      collabDetails[a.slug] = {
        name: a.display,
        url: info?.url || undefined,
        affiliation: info?.affiliation || undefined,
        pubs: [],
        fields: [],
        apps: [],
      };
    }
    const d = collabDetails[a.slug];
    d.pubs.push({ title: p.title, year: p.year, links: p.links });
    const bump = (list: FacetCount[], id: string, facets: { id: string; label: string }[]) => {
      const hit = list.find((x) => x.id === id);
      if (hit) hit.n++;
      else list.push({ id, label: facets.find((f) => f.id === id)?.label ?? id, n: 1 });
    };
    p.cls.fields.forEach((id) => bump(d.fields, id, FIELDS));
    p.cls.apps.forEach((id) => bump(d.apps, id, APPLICATIONS));
  }
}
for (const d of Object.values(collabDetails)) {
  d.pubs.sort((a, b) => b.year - a.year);
  d.fields.sort((a, b) => b.n - a.n);
  d.apps.sort((a, b) => b.n - a.n);
}

// legend: only topics actually assigned to a co-author
const usedTopics = new Set(graph.nodes.flatMap((n) => n.shares?.map((x) => x.id) ?? (n.topic ? [n.topic] : [])));
const legendTopics = TOPICS.filter((t) => usedTopics.has(t.id));
// co-authors with no classified paper share the grey of the "Other" application,
// so they are folded into a single "Other" legend entry
const hasUncategorised = graph.nodes.some((n) => !n.elia && !n.topic) && !usedTopics.has('other');

const impact = [
  { label: 'Citations', value: String(metrics.citations) },
  { label: 'h-index', value: String(metrics.hIndex) },
  { label: 'i10-index', value: String(metrics.i10Index) },
  { label: 'Indexed works', value: String(metrics.worksMatched) },
];
const maxYearCites = Math.max(1, ...metrics.perYear.map((p) => p.citations));
---
<BaseLayout
  title="Statistics"
  description="Publication metrics and an interactive co-authorship network for Elia Onofri."
>
  <div class="wrap page-body">
    <p class="eyebrow">Statistics</p>
    <h1>By the numbers</h1>
    <p class="lead">
      A look at the shape of my research output, built from the same data as <a href="/publications">publication</a>.
      Citation metrics (h-index &amp; co.) are drawn from OpenAlex.
    </p>

    <div class="stat-grid">
      {stats.map((s) => (
        <div class="stat">
          <span class="stat-value">{s.value}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))}
    </div>

    <section class="block">
      <h2 class="sec-title">Citation impact</h2>
      <p class="block-intro">
        Citations to my indexed works via <a href="https://openalex.org" target="_blank" rel="noopener">OpenAlex</a>,
        anchored to the listed DOIs ({metrics.worksMatched} of {metrics.doisQueried} indexed). Author-profile metrics
        elsewhere can conflate distinct “E. Onofri” authors, so these count only my own works. <br>Updated {metrics.updated}.
      </p>
      <div class="impact-grid">
        {impact.map((s) => (
          <div class="stat">
            <span class="stat-value">{s.value}</span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))}
      </div>
      <div class="spark">
        <p class="spark-title">Citations per year</p>
        <div class="bars">
          {metrics.perYear.map((p) => (
            <div class="bar-col" title={`${p.year}: ${p.citations} citations`}>
              <span class="bar-val">{p.citations}</span>
              <div class="bar" style={`height:${Math.round((p.citations / maxYearCites) * 100)}%`}></div>
              <span class="bar-year">{String(p.year).slice(0)}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="block">
      <h2 class="sec-title">Collaboration network</h2>
      <p class="block-intro">
        Every co-author, sized by shared papers, linked when they appear together and coloured by the applications of
        those papers — in slices when they span several. Drag a node, scroll or pinch to zoom, drag the background to
        pan; hover to focus, click a node or a name below to open their profile card.
      </p>

      <figure class="graph-figure">
        <div class="graph-wrap">
          <div id="graph" class="graph" role="img"
            aria-label={`Co-authorship network: Elia Onofri and ${collabs.length} co-authors.`}></div>
          <div class="graph-controls">
            <button type="button" data-zoom="in" aria-label="Zoom in">+</button>
            <button type="button" data-zoom="out" aria-label="Zoom out">−</button>
            <button type="button" data-zoom="reset" aria-label="Reset view">⟲</button>
            <button type="button" id="graph-sound" aria-pressed="false" aria-label="Sound" title="Sound"></button>
          </div>
        </div>
        <figcaption class="graph-legend">
          <span class="lg lg-me">Elia</span>
          {legendTopics.map((t) => <span class="lg lg-topic" style={`--c: var(--a-${t.id})`}>{t.label}</span>)}
          {hasUncategorised && <span class="lg lg-other">Other</span>}
          <span class="lg lg-link">profile on file</span>
        </figcaption>
      </figure>

      <!-- no-JS / accessible fallback + most-frequent collaborators -->
      <div class="top">
        <h3 class="top-head">Most frequent co-authors</h3>
        <ol class="top-list">
          {top.map((c) => (
            <li>
              <button class="top-collab-btn" data-collab-slug={c.slug}>{c.name}</button>
              <span class="top-count">{c.count} paper{c.count > 1 ? 's' : ''}</span>
              {c.aff && <span class="top-aff">{c.aff}</span>}
            </li>
          ))}
        </ol>
      </div>
    </section>
  </div>

  <script type="application/json" id="graph-data" set:html={JSON.stringify(graph)}></script>
  <script type="application/json" id="collab-details" set:html={JSON.stringify(collabDetails)}></script>

  <dialog id="collab-modal" class="collab-modal">
    <div class="cmodal-box">
      <button class="cmodal-close" id="collab-modal-close" aria-label="Close">×</button>
      <div id="cmodal-content"></div>
    </div>
  </dialog>
</BaseLayout>

<script>
  import { forceSimulation, forceManyBody, forceLink, forceCenter, forceCollide, forceX, forceY } from 'd3-force';
  import { unlock, record } from '@/scripts/eggs';
  import { speakerButton, soundOn, note } from '@/scripts/sound';

  interface GNode { id: string; name: string; count: number; elia: boolean; url?: string; topic?: string; shares?: { id: string; w: number }[]; x?: number; y?: number; fx?: number | null; fy?: number | null; }
  interface GLink { source: any; target: any; weight: number; }
  interface CollabPub { title: string; year: number; links: { label: string; href: string }[]; }
  interface FacetCount { id: string; label: string; n: number; }
  interface CollabDetail { name: string; url?: string; affiliation?: string; pubs: CollabPub[]; fields: FacetCount[]; apps: FacetCount[]; }

  // ── collab modal ──────────────────────────────────────────────────────────
  const collabDetailsEl = document.getElementById('collab-details');
  const collabDetails = JSON.parse(collabDetailsEl?.textContent || '{}') as Record<string, CollabDetail>;
  const collabModal = document.getElementById('collab-modal') as HTMLDialogElement | null;
  const collabContent = document.getElementById('cmodal-content');
  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

  function openCollabModal(slug: string) {
    if (!collabModal || !collabContent) return;
    const d = collabDetails[slug];
    if (!d) return;
    let html = `<header class="cmodal-head">`;
    html += `<h3 class="cmodal-name">${esc(d.name)}</h3>`;
    if (d.affiliation) html += `<p class="cmodal-aff">${esc(d.affiliation)}</p>`;
    if (d.url) html += `<a class="cmodal-link" href="${esc(d.url)}" target="_blank" rel="noopener">Profile ↗</a>`;
    html += `</header>`;
    // distribution of the shared papers over fields and applications
    if (d.fields.length > 0 || d.apps.length > 0) {
      html += `<div class="cmodal-dist">`;
      if (d.apps.length > 0) {
        html += `<p class="cmodal-dist-head">Application</p><div class="cmodal-bar">`;
        for (const a of d.apps) html += `<span style="flex:${a.n};background:var(--a-${a.id})" title="${esc(a.label)}: ${a.n}"></span>`;
        html += `</div><ul class="cmodal-dist-list">`;
        for (const a of d.apps) html += `<li style="--c:var(--a-${a.id})" class="is-app">${esc(a.label)} <b>${a.n}</b></li>`;
        html += `</ul>`;
      }
      if (d.fields.length > 0) {
        html += `<p class="cmodal-dist-head">Field</p><ul class="cmodal-dist-list">`;
        for (const f of d.fields) html += `<li>${esc(f.label)} <b>${f.n}</b></li>`;
        html += `</ul>`;
      }
      html += `</div>`;
    }
    if (d.pubs.length > 0) {
      html += `<div class="cmodal-pubs">`;
      html += `<p class="cmodal-pubs-head">${d.pubs.length} shared paper${d.pubs.length > 1 ? 's' : ''}</p>`;
      html += `<ol class="cmodal-pub-list">`;
      for (const p of d.pubs) {
        html += `<li class="cmodal-pub">`;
        html += `<span class="cmodal-pub-meta"><span class="cmodal-pub-year">${p.year}</span>`;
        if (p.links.length > 0) {
          for (const l of p.links) {
            html += `<a class="cmodal-pub-lnk" href="${esc(l.href)}" target="_blank" rel="noopener">${esc(l.label)} ↗</a>`;
          }
        }
        html += `</span>`;
        html += `<span class="cmodal-pub-title">${p.title}</span>`;
        html += `</li>`;
      }
      html += `</ol></div>`;
    }
    collabContent.innerHTML = html;
    collabModal.showModal();
  }

  document.getElementById('collab-modal-close')?.addEventListener('click', () => collabModal?.close());
  collabModal?.addEventListener('click', (e) => { if (e.target === collabModal) collabModal.close(); });
  document.querySelectorAll<HTMLButtonElement>('[data-collab-slug]').forEach((btn) => {
    btn.addEventListener('click', () => openCollabModal(btn.dataset.collabSlug!));
  });

  const dataEl = document.getElementById('graph-data');
  const host = document.getElementById('graph');
  if (dataEl && host) {
    const graph = JSON.parse(dataEl.textContent || '{"nodes":[],"links":[]}') as { nodes: GNode[]; links: GLink[] };
    const SVGNS = 'http://www.w3.org/2000/svg';
    const clamp = (v: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, v));

    let width = host.clientWidth || 720;
    let height = Math.max(420, Math.min(620, Math.round(width * 0.78)));

    const svg = document.createElementNS(SVGNS, 'svg');
    svg.setAttribute('width', '100%');
    svg.setAttribute('height', String(height));
    svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
    host.appendChild(svg);

    // zoom/pan viewport
    const viewport = document.createElementNS(SVGNS, 'g');
    svg.appendChild(viewport);
    const gLinks = document.createElementNS(SVGNS, 'g');
    const gNodes = document.createElementNS(SVGNS, 'g');
    viewport.appendChild(gLinks);
    viewport.appendChild(gNodes);

    const view = { x: 0, y: 0, k: 1 };
    function applyView() {
      viewport.setAttribute('transform', `translate(${view.x} ${view.y}) scale(${view.k})`);
      svg.classList.toggle('zoomed', view.k >= 1.5);
    }
    const svgPoint = (ev: { clientX: number; clientY: number }) => {
      const r = svg.getBoundingClientRect();
      return { x: ((ev.clientX - r.left) / r.width) * width, y: ((ev.clientY - r.top) / r.height) * height };
    };
    const worldFromSvg = (p: { x: number; y: number }) => ({ x: (p.x - view.x) / view.k, y: (p.y - view.y) / view.k });
    function zoomAt(sp: { x: number; y: number }, factor: number) {
      const w = worldFromSvg(sp);
      view.k = clamp(view.k * factor, 0.4, 5);
      view.x = sp.x - w.x * view.k;
      view.y = sp.y - w.y * view.k;
      applyView();
    }

    const radius = (n: GNode) => (n.elia ? 13 : 4 + Math.sqrt(n.count) * 2.4);

    // adjacency for hover focus
    const adj = new Map<string, Set<string>>();
    graph.nodes.forEach((n) => adj.set(n.id, new Set([n.id])));
    graph.links.forEach((l) => {
      const s = typeof l.source === 'object' ? l.source.id : l.source;
      const t = typeof l.target === 'object' ? l.target.id : l.target;
      adj.get(s)?.add(t);
      adj.get(t)?.add(s);
    });

    const lineEls = graph.links.map((l) => {
      const ln = document.createElementNS(SVGNS, 'line');
      ln.setAttribute('class', 'g-link');
      ln.setAttribute('stroke-width', String(Math.min(3, 0.6 + l.weight * 0.5)));
      gLinks.appendChild(ln);
      return ln;
    });

    const nodeEls = graph.nodes.map((n) => {
      const cls = ['g-node'];
      if (n.elia) cls.push('is-me');
      if (n.url) cls.push('has-link');
      if (n.elia || n.count >= 3) cls.push('big');
      const pie = (n.shares?.length ?? 0) > 1;
      if (pie) cls.push('pie');
      else if (n.topic) cls.push('has-topic');
      const g = document.createElementNS(SVGNS, 'g');
      g.setAttribute('class', cls.join(' '));
      g.setAttribute('tabindex', '0');
      const r = radius(n);
      if (pie) {
        // one slice per field, proportional to the shared papers in that field
        let a0 = -Math.PI / 2;
        for (const sh of n.shares!) {
          const a1 = a0 + sh.w * 2 * Math.PI;
          const path = document.createElementNS(SVGNS, 'path');
          const large = a1 - a0 > Math.PI ? 1 : 0;
          path.setAttribute('d', `M0 0 L${r * Math.cos(a0)} ${r * Math.sin(a0)} A${r} ${r} 0 ${large} 1 ${r * Math.cos(a1)} ${r * Math.sin(a1)} Z`);
          path.setAttribute('class', 'g-slice');
          path.style.fill = `var(--a-${sh.id})`;
          g.appendChild(path);
          a0 = a1;
        }
      }
      const c = document.createElementNS(SVGNS, 'circle');
      c.setAttribute('r', String(r));
      if (!pie && n.topic && !n.elia) c.style.fill = `var(--a-${n.topic})`;
      g.appendChild(c);
      const label = document.createElementNS(SVGNS, 'text');
      label.setAttribute('class', 'g-label');
      label.setAttribute('dy', '-0.7em');
      label.textContent = n.name;
      g.appendChild(label);
      const native = document.createElementNS(SVGNS, 'title');
      native.textContent = `${n.name} — ${n.count} paper${n.count > 1 ? 's' : ''}`;
      g.appendChild(native);
      gNodes.appendChild(g);

      const open = () => { if (!n.elia) openCollabModal(n.id); };
      let moved = false;
      let down: { x: number; y: number } | null = null;

      g.addEventListener('pointerdown', (ev) => {
        ev.stopPropagation();
        (ev as PointerEvent).preventDefault();
        moved = false;
        down = svgPoint(ev as PointerEvent);
        n.fx = n.x; n.fy = n.y;
        dragNode = n;
        sim.alphaTarget(0.4).restart();
        g.setPointerCapture((ev as PointerEvent).pointerId);
      });
      g.addEventListener('pointermove', (ev) => {
        if (dragNode !== n) return;
        const sp = svgPoint(ev as PointerEvent);
        if (down && Math.hypot(sp.x - down.x, sp.y - down.y) > 3) moved = true;
        const w = worldFromSvg(sp);
        n.fx = w.x; n.fy = w.y;
      });
      const endNode = () => {
        if (dragNode !== n) return;
        if (!moved && !n.elia) open();    // click, not a drag → open modal
        if (!moved && n.elia) hop();      // the central node is a knight (easter egg below)
        if (!n.elia) { n.fx = null; n.fy = null; }
        dragNode = null;
        sim.alphaTarget(0);
      };
      g.addEventListener('pointerup', endNode);
      g.addEventListener('pointercancel', endNode);
      g.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') open(); });
      g.addEventListener('pointerenter', () => { focus(n.id); play(n); });
      g.addEventListener('pointerleave', () => focus(null));
      g.addEventListener('focus', () => focus(n.id));
      g.addEventListener('blur', () => focus(null));
      return g;
    });

    function focus(id: string | null) {
      const near = id ? adj.get(id) : null;
      nodeEls.forEach((el, i) => {
        const nid = graph.nodes[i].id;
        const on = !near || near.has(nid);
        el.classList.toggle('dim', !on);
        el.classList.toggle('lbl', !!id && !!near && near.has(nid));
      });
      lineEls.forEach((el, i) => {
        const l = graph.links[i];
        const s = typeof l.source === 'object' ? l.source.id : l.source;
        const t = typeof l.target === 'object' ? l.target.id : l.target;
        el.classList.toggle('dim', !!id && s !== id && t !== id);
      });
    }

    const me = graph.nodes.find((n) => n.elia)!;
    me.fx = width / 2; me.fy = height / 2;

    const sim = forceSimulation<GNode>(graph.nodes)
      .force('link', forceLink<GNode, GLink>(graph.links).id((d) => d.id).distance((l) => 60 / Math.sqrt(l.weight)).strength(0.25))
      .force('charge', forceManyBody().strength(-160))
      .force('collide', forceCollide<GNode>().radius((n) => radius(n) + 3))
      .force('x', forceX(width / 2).strength(0.04))
      .force('y', forceY(height / 2).strength(0.04))
      .force('center', forceCenter(width / 2, height / 2))
      .on('tick', tick);

    // ── easter egg: with the sound on, hovering a co-author plays a note of C major, one
    // step higher per shared paper; three notes of a triad within 1.5 s make a chord ──
    const DEGREES = [0, 2, 4, 5, 7, 9, 11];
    const heard: { d: number; t: number }[] = [];
    speakerButton(document.getElementById('graph-sound') as HTMLButtonElement);
    function play(n: GNode) {
      if (!soundOn() || n.elia) return;
      const i = n.count - 1;
      note(261.63 * 2 ** ((12 * Math.floor(i / 7) + DEGREES[i % 7]) / 12), 0, 0.9);
      const now = performance.now();
      heard.push({ d: i % 7, t: now });
      while (now - heard[0].t > 1500) heard.shift();
      const degrees = new Set(heard.map((h) => h.d));
      if ([0, 1, 2, 3, 4, 5, 6].some((r) => degrees.has(r) && degrees.has((r + 2) % 7) && degrees.has((r + 4) % 7))) unlock('ensemble');
    }

    // ── easter egg: N, or a click on the central node, moves it like a chess knight over
    // an 8×8 board, touring it by Warnsdorff's rule (complete from e4); Esc ends the tour ──
    const KN = [[1, 2], [2, 1], [2, -1], [1, -2], [-1, -2], [-2, -1], [-2, 1], [-1, 2]];
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const board = document.createElementNS(SVGNS, 'g');
    board.setAttribute('class', 'g-board');
    viewport.insertBefore(board, gLinks);
    // square s = file * 8 + rank; a1 is dark
    const squares = Array.from({ length: 64 }, (_, i) => {
      const r = document.createElementNS(SVGNS, 'rect');
      r.setAttribute('class', `g-sq ${((i >> 3) + (i & 7)) % 2 ? 'lt' : 'dk'}`);
      board.appendChild(r);
      return r;
    });
    const log = document.createElement('div');
    log.className = 'knight-log';
    host.parentElement!.appendChild(log);
    let tour: number[] = [];
    let hopping = false;
    const unit = () => Math.min(width, height) / 9.5;
    const sqPos = (q: number) => ({ x: width / 2 + ((q >> 3) - 3.5) * unit(), y: height / 2 - ((q & 7) - 3.5) * unit() });
    const sqName = (q: number) => 'abcdefgh'[q >> 3] + ((q & 7) + 1);
    const free = (f: number, r: number) => f >= 0 && f < 8 && r >= 0 && r < 8 && !tour.includes(f * 8 + r);
    const exits = (q: number) => KN.filter(([a, b]) => free((q >> 3) + a, (q & 7) + b)).map(([a, b]) => ((q >> 3) + a) * 8 + (q & 7) + b);
    function layoutBoard() {
      const u = unit();
      squares.forEach((r, i) => {
        const p = sqPos(i);
        r.setAttribute('x', String(p.x - u / 2));
        r.setAttribute('y', String(p.y - u / 2));
        r.setAttribute('width', String(u));
        r.setAttribute('height', String(u));
      });
    }
    function hop() {
      if (hopping) return;
      if (!tour.length) {
        tour = [4 * 8 + 3];             // e4
        squares[tour[0]].classList.add('seen');
        layoutBoard();
        svg.classList.add('touring');
      }
      const from = tour[tour.length - 1];
      const next = exits(from).sort((p, q) => exits(p).length - exits(q).length)[0];
      if (next === undefined) return;
      tour.push(next);
      squares[next].classList.add('seen');
      record('knight', tour.length);
      log.textContent = tour.length === 64
        ? '♘ 64/64 · tour complete'
        : `♘ ${tour.length}/64 · N${sqName(from)}–${sqName(next)}`;
      if (tour.length === 64) unlock('knight');
      // along the L: the long leg first, then the short one
      hopping = true;
      const p0 = { x: me.fx ?? width / 2, y: me.fy ?? height / 2 };
      const p1 = sqPos(next);
      const corner = Math.abs((next >> 3) - (from >> 3)) === 2 ? { x: p1.x, y: p0.y } : { x: p0.x, y: p1.y };
      const t0 = performance.now();
      const D = still ? 0 : 260;
      sim.alphaTarget(0.3).restart();
      const frame = (now: number) => {
        if (!hopping) return;
        const t = D ? Math.min(1, (now - t0) / D) : 1;
        const [a, b, u] = t < 2 / 3 ? [p0, corner, t * 1.5] : [corner, p1, (t - 2 / 3) * 3];
        me.fx = a.x + (b.x - a.x) * u;
        me.fy = a.y + (b.y - a.y) * u;
        if (t < 1) requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
      // the hop ends on a timer, so that it lands even where frames are not drawn
      window.setTimeout(() => {
        hopping = false;
        me.fx = p1.x; me.fy = p1.y;
        sim.alphaTarget(0);
      }, D);
    }
    function endTour() {
      tour = [];
      squares.forEach((r) => r.classList.remove('seen'));
      svg.classList.remove('touring');
      log.textContent = '';
      me.fx = width / 2; me.fy = height / 2;
      sim.alpha(0.3).restart();
    }
    document.addEventListener('keydown', (ev) => {
      const el = ev.target as HTMLElement;
      if (ev.ctrlKey || ev.metaKey || ev.altKey || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName)) return;
      if (ev.key.toLowerCase() === 'n') hop();
      else if (ev.key === 'Escape' && tour.length && !document.querySelector('dialog[open]')) endTour();
    });

    function tick() {
      const pad = 14;
      graph.nodes.forEach((n) => {
        n.x = Math.max(pad, Math.min(width - pad, n.x ?? width / 2));
        n.y = Math.max(pad, Math.min(height - pad, n.y ?? height / 2));
      });
      lineEls.forEach((el, i) => {
        const l = graph.links[i];
        el.setAttribute('x1', String((l.source as GNode).x));
        el.setAttribute('y1', String((l.source as GNode).y));
        el.setAttribute('x2', String((l.target as GNode).x));
        el.setAttribute('y2', String((l.target as GNode).y));
      });
      nodeEls.forEach((el, i) => {
        const n = graph.nodes[i];
        el.setAttribute('transform', `translate(${n.x},${n.y})`);
      });
    }

    // ── pan (background drag) + zoom (wheel / buttons) ──
    let dragNode: GNode | null = null;
    let panning = false;
    let panStart: { x: number; y: number } | null = null;
    let panOrig = { x: 0, y: 0 };

    svg.addEventListener('pointerdown', (ev) => {
      panning = true;
      panStart = svgPoint(ev as PointerEvent);
      panOrig = { x: view.x, y: view.y };
      svg.classList.add('panning');
      svg.setPointerCapture((ev as PointerEvent).pointerId);
    });
    svg.addEventListener('pointermove', (ev) => {
      if (!panning || !panStart) return;
      const sp = svgPoint(ev as PointerEvent);
      view.x = panOrig.x + (sp.x - panStart.x);
      view.y = panOrig.y + (sp.y - panStart.y);
      applyView();
    });
    const endPan = () => { panning = false; svg.classList.remove('panning'); };
    svg.addEventListener('pointerup', endPan);
    svg.addEventListener('pointercancel', endPan);
    svg.addEventListener('wheel', (ev) => {
      ev.preventDefault();
      zoomAt(svgPoint(ev), (ev as WheelEvent).deltaY < 0 ? 1.15 : 1 / 1.15);
    }, { passive: false });

    const controls = host.parentElement?.querySelector('.graph-controls');
    controls?.addEventListener('click', (ev) => {
      const b = (ev.target as HTMLElement).closest('[data-zoom]') as HTMLElement | null;
      if (!b) return;
      const center = { x: width / 2, y: height / 2 };
      if (b.dataset.zoom === 'in') zoomAt(center, 1.3);
      else if (b.dataset.zoom === 'out') zoomAt(center, 1 / 1.3);
      else { view.x = 0; view.y = 0; view.k = 1; applyView(); }
    });

    window.addEventListener('resize', () => {
      const w = host.clientWidth || width;
      if (Math.abs(w - width) < 2) return;
      width = w;
      height = Math.max(420, Math.min(620, Math.round(width * 0.78)));
      svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
      svg.setAttribute('height', String(height));
      me.fx = width / 2; me.fy = height / 2;
      if (tour.length) {
        layoutBoard();
        const p = sqPos(tour[tour.length - 1]);
        me.fx = p.x; me.fy = p.y;
      }
      sim.force('center', forceCenter(width / 2, height / 2));
      sim.force('x', forceX(width / 2).strength(0.04));
      sim.force('y', forceY(height / 2).strength(0.04));
      sim.alpha(0.4).restart();
    });
  }
</script>

