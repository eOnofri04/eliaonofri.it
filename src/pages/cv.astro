---
import BaseLayout from '@/layouts/BaseLayout.astro';
// Easter egg: the knight beside the heading opens a mate-in-two puzzle from Lichess
// (CC0), refreshed at every deploy by scripts/fetch-puzzle.mjs.
import puzzle from '@/data/puzzle.json';
const side = puzzle.fen.split(' ')[1] === 'b' ? 'Black' : 'White';
---
<BaseLayout title="CV" description="Curriculum Vitae of Elia Onofri.">
  <div class="wrap page-body cv-wrap">
    <p class="eyebrow">Curriculum Vitae</p>
    <h1>Download CV <button class="knight" id="knight" type="button" aria-label="A chess puzzle" title="Fancy a game?">♞&#xFE0E;</button></h1>
    <p class="sub">Available in two themes — same content, different palette.</p>
    <div class="cv-buttons">
      <a class="cv-btn cv-btn--dark" href="/cv/CV_Onofri_dark.pdf" download>
        Dark theme ↓
      </a>
      <a class="cv-btn cv-btn--light" href="/cv/CV_Onofri_light.pdf" download>
        Light theme ↓
      </a>
    </div>
    <p id="gpg" class="gpg-note">
      <span class="gpg-label">GPG key</span> —
      <a href="/elia-onofri.asc" download>download public key (.asc)</a><br />
      <span class="gpg-fpr">64F7 305E 9FD8 1D8F 82EE&nbsp;&nbsp;69E1 0387 FD2F CD5E 487D</span>
    </p>
  </div>

  <dialog class="chess" id="chess" aria-label="Mate in two">
    <div class="chess-head">
      <div>
        <h2>Mate in two</h2>
        <p>{side} to move.</p>
      </div>
      <button type="button" class="chess-close" data-close aria-label="Close">×</button>
    </div>
    <div class="board" id="board"></div>
    <p class="chess-status" id="chess-status" aria-live="polite"></p>
    <div class="chess-foot">
      <button type="button" id="chess-reset">reset</button>
      <a href={`https://lichess.org/training/${puzzle.id}`} target="_blank" rel="noopener">Lichess puzzle {puzzle.id} · rating {puzzle.rating}</a>
    </div>
  </dialog>
  <script type="application/json" id="puzzle-data" set:html={JSON.stringify(puzzle)}></script>
</BaseLayout>

<script>
  import { Chess, type Square, type Move } from 'chess.js';
  import { unlock } from '@/scripts/eggs';

  const P = JSON.parse(document.getElementById('puzzle-data')!.textContent!) as { fen: string; solution: string[] };
  const dlg = document.getElementById('chess') as HTMLDialogElement;
  const board = document.getElementById('board')!;
  const status = document.getElementById('chess-status')!;
  const GLYPH: Record<string, string> = { k: '♚', q: '♛', r: '♜', b: '♝', n: '♞', p: '♟' };
  const NAME: Record<string, string> = { k: 'king', q: 'queen', r: 'rook', b: 'bishop', n: 'knight', p: 'pawn' };
  const FILES = 'abcdefgh';
  const me = new Chess(P.fen).turn();
  const uci = (m: Move) => m.from + m.to + (m.promotion ?? '');

  let game = new Chess(P.fen);
  let step = 0;                       // index into the solution: 0 and 2 are ours
  let selected: Square | null = null;
  let last: Move | null = null;
  let locked = false;

  // the board seen from the side to move
  const order: Square[] = [];
  for (let r = 0; r < 8; r++) {
    for (let f = 0; f < 8; f++) {
      order.push(((me === 'w' ? FILES[f] : FILES[7 - f]) + (me === 'w' ? 8 - r : r + 1)) as Square);
    }
  }

  function render() {
    const targets = selected ? game.moves({ square: selected, verbose: true }).map((m) => m.to) : [];
    board.innerHTML = '';
    order.forEach((sq, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.dataset.sq = sq;
      const p = game.get(sq);
      b.className = `sq ${(FILES.indexOf(sq[0]) + Number(sq[1])) % 2 ? 'dk' : 'lt'}`;
      if (p) {
        b.textContent = GLYPH[p.type] + '\uFE0E';
        b.classList.add(p.color === 'w' ? 'pw' : 'pb');
      }
      if (sq === selected) b.classList.add('sel');
      if (last && (sq === last.from || sq === last.to)) b.classList.add('last');
      if (targets.includes(sq)) b.insertAdjacentHTML('beforeend', '<i class="dot"></i>');
      if (i % 8 === 0) b.dataset.rank = sq[1];
      if (i >= 56) b.dataset.file = sq[0];
      b.setAttribute('aria-label', sq + (p ? ` ${p.color === 'w' ? 'white' : 'black'} ${NAME[p.type]}` : ''));
      board.appendChild(b);
    });
  }

  function reset() {
    game = new Chess(P.fen);
    step = 0;
    selected = null;
    last = null;
    locked = false;
    status.textContent = '';
    render();
  }

  function retry(text: string) {
    status.textContent = text;
    locked = true;
    window.setTimeout(reset, 1200);
  }

  function attempt(from: Square, to: Square) {
    selected = null;
    const want = P.solution[step];
    let m: Move;
    try {
      m = game.move({ from, to, promotion: want.startsWith(from + to) && want[4] ? want[4] : 'q' });
    } catch {
      render();   // not a legal move: just deselect
      return;
    }
    last = m;
    render();
    if (step === 0) {
      if (uci(m) !== want) return retry('Not the key move. Try again.');
      locked = true;
      status.textContent = 'Good. Your opponent replies…';
      window.setTimeout(() => {
        const r = P.solution[1];
        last = game.move({ from: r.slice(0, 2), to: r.slice(2, 4), promotion: r[4] });
        step = 2;
        locked = false;
        status.textContent = 'Now mate in one.';
        render();
      }, 700);
    } else if (game.isCheckmate()) {
      locked = true;
      status.textContent = 'Checkmate!';
      unlock('mate');
    } else {
      retry('Not mate. Try again.');
    }
  }

  board.addEventListener('click', (ev) => {
    const sq = (ev.target as HTMLElement).closest<HTMLElement>('[data-sq]')?.dataset.sq as Square | undefined;
    if (!sq || locked) return;
    const p = game.get(sq);
    const own = !!p && p.color === me;
    if (selected && sq !== selected && !own) return attempt(selected, sq);
    selected = own && sq !== selected ? sq : null;
    render();
  });

  document.getElementById('knight')!.addEventListener('click', () => {
    reset();
    dlg.showModal();
  });
  document.getElementById('chess-reset')!.addEventListener('click', reset);
  dlg.addEventListener('click', (ev) => {
    const t = ev.target as HTMLElement;
    if (t === dlg || t.closest('[data-close]')) dlg.close();
  });
</script>

<style>
  .cv-wrap { max-width: 52ch; }
  h1 { font-size: clamp(2rem, 4vw, 2.8rem); margin-bottom: 10px; }
  .sub { color: var(--ink-soft); margin: 0 0 32px; }
  .cv-buttons { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 40px; }
  .cv-btn {
    font-family: var(--mono);
    font-size: 0.9rem;
    padding: 13px 22px;
    border-radius: 10px;
    border: 1px solid var(--rule);
    transition: border-color 0.18s, background 0.18s;
  }
  .cv-btn--dark  { background: var(--panel); color: var(--ink); }
  .cv-btn--light { background: var(--teal-tint); border-color: var(--teal); color: var(--teal); }
  .cv-btn:hover { border-color: var(--teal); background: var(--teal-tint); color: var(--teal); }
  .gpg-note { font-family: var(--mono); font-size: 0.84rem; color: var(--muted); line-height: 1.9; }
  .gpg-label { color: var(--ink-soft); }
  .gpg-note a { color: var(--teal); }
  .gpg-note a:hover { text-decoration: underline; }
  /* the chess easter egg */
  .knight {
    padding: 0;
    border: 0;
    background: none;
    font-family: 'Apple Symbols', 'Segoe UI Symbol', 'DejaVu Sans', serif;
    font-size: 0.5em;
    vertical-align: 0.35em;
    color: var(--muted);
    opacity: 0.45;
    cursor: pointer;
  }
  .knight:hover { opacity: 1; color: var(--gold); }
  .chess {
    --b: min(400px, calc(100vw - 72px));
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 13px;
    background: var(--panel);
    color: var(--ink);
  }
  .chess::backdrop { background: rgba(15, 15, 12, 0.82); }
  .chess-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px 10px;
  }
  .chess-head h2 { font-family: var(--serif); font-size: 1.3rem; margin: 0; }
  .chess-head p { margin: 2px 0 0; font-family: var(--mono); font-size: 0.78rem; color: var(--muted); }
  .chess-close {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--rule);
    background: transparent;
    color: var(--ink);
    font-size: 1.2rem;
    cursor: pointer;
  }
  .board {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    grid-template-rows: repeat(8, 1fr);
    width: var(--b);
    height: var(--b);
    margin: 0 20px;
    border: 1px solid var(--rule);
  }
  .board :global(.sq) {
    position: relative;
    padding: 0;
    border: 0;
    font-family: 'Apple Symbols', 'Segoe UI Symbol', 'DejaVu Sans', serif;
    font-size: calc(var(--b) / 8 * 0.74);
    line-height: 1;
    cursor: pointer;
  }
  .board :global(.lt) { background: #e6d8bd; }
  .board :global(.dk) { background: #a97a58; }
  .board :global(.pw) { color: #fcfcfa; -webkit-text-stroke: 1px #22221c; }
  .board :global(.pb) { color: #22221c; }
  .board :global(.last) { box-shadow: inset 0 0 0 100px rgba(224, 179, 84, 0.35); }
  .board :global(.sel) { box-shadow: inset 0 0 0 3px #e0b354; }
  .board :global(.dot) {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 26%;
    height: 26%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: rgba(34, 34, 28, 0.3);
  }
  .board :global([data-rank])::before,
  .board :global([data-file])::after {
    position: absolute;
    font: 600 9px var(--mono);
    -webkit-text-stroke: 0;
    color: rgba(34, 34, 28, 0.6);
  }
  .board :global([data-rank])::before { content: attr(data-rank); top: 2px; left: 3px; }
  .board :global([data-file])::after { content: attr(data-file); bottom: 1px; right: 3px; }
  .chess-status {
    min-height: 1.5em;
    margin: 10px 20px 0;
    font-family: var(--mono);
    font-size: 0.82rem;
    color: var(--gold);
  }
  .chess-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 10px 20px 16px;
    font-family: var(--mono);
    font-size: 0.72rem;
  }
  .chess-foot a { color: var(--muted); }
  .chess-foot a:hover { color: var(--teal); }
  .chess-foot button {
    font: inherit;
    color: var(--muted);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 12px;
    padding: 2px 10px;
    cursor: pointer;
  }
  .gpg-fpr { color: var(--ink-soft); font-size: 0.78rem; letter-spacing: 0.02em; }
</style>
