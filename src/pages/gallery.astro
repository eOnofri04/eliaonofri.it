---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import GalleryCard from '@/components/GalleryCard.astro';
import FacetFilters from '@/components/FacetFilters.astro';
import { getPublications } from '@/lib/bib';
import { classify, merge, usedFacets } from '@/lib/taxonomy';

// A piece may name its paper by bib key; its date and classification then come from the bib.
const pubs = new Map(getPublications().map((p) => [p.key, p]));
const entries = await getCollection('gallery');

const pieces = entries
  .map((e) => {
    const key = e.data.source?.trim() || undefined;
    const pub = key ? pubs.get(key) : undefined;
    if (key && !pub) throw new Error(`[gallery] ${e.id}: unknown bib key "${key}"`);
    const cls = merge(pub?.cls ?? classify([]), classify(e.data.topics ?? [], e.id));
    const tagChip = cls.chips.find((c) => c.facet === 'app') ?? cls.chips[0];
    const pubDate = pub?.year ? `${pub.year}${pub.month ? '-' + String(pub.month).padStart(2, '0') : ''}` : '';
    const date = e.data.date ?? pubDate;
    return {
      id: e.id,
      ...e.data,
      source: key,
      date,
      year: pub?.year ?? (parseInt(date.slice(0, 4), 10) || 0),
      cls,
      tag: tagChip ? (tagChip.sub ?? tagChip.label) : 'Research',
      sourceTitle: pub ? pub.title.replace(/<[^>]+>/g, '') : '',
      // mock EXIF line for the lightbox; dpi defaults to the year of the piece
      exifLine: e.data.exif ? [
        e.data.exif.camera,
        e.data.exif.aperture && `f/${e.data.exif.aperture}`,
        e.data.exif.exposure,
        e.data.exif.iso && `ISO ${e.data.exif.iso}`,
        `${e.data.exif.dpi ?? (parseInt(date.slice(0, 4), 10) || pub?.year || '')} dpi`,
      ].filter(Boolean).join(' · ') : '',
    };
  })
  // newest first; undated pieces last
  .sort((a, b) => b.date.localeCompare(a.date) || a.title.localeCompare(b.title));

const facets = usedFacets(pieces.map((p) => p.cls));
---
<BaseLayout title="Gallery" description="Scientific figures presented as artworks.">
  <div class="wrap page-body">
    <p class="eyebrow">Gallery</p>
    <h1 class="gallery-title">Figures as artworks</h1>
    <p class="lead">
      A selection of graphics produced in the course of my research that, stripped of their context,
      stand on their own. Each links back to the work it came from.
    </p>

    <FacetFilters target="gal-grid" fields={facets.fields} apps={facets.apps} />

    <div class="gal-grid" id="gal-grid" data-total={pieces.length}>
      {pieces.map((p) => (
        <GalleryCard
          id={p.id}
          title={p.title}
          caption={p.caption}
          alt={p.alt}
          image={p.image}
          width={p.width}
          height={p.height}
          tag={p.tag}
          year={p.year}
          sourceKey={p.source}
          sourceTitle={p.sourceTitle}
          cls={p.cls}
          exif={p.exifLine}
        />
      ))}
    </div>

    <p class="licence">
      Figures are released under <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" rel="license noopener" target="_blank">CC BY-NC-SA 4.0</a>;
      please cite the source paper when reusing them.
    </p>
  </div>

  <dialog class="lightbox" id="lightbox" aria-label="Enlarged figure">
    <button class="lb-close" type="button" data-lb="close" aria-label="Close">×</button>
    <button class="lb-nav lb-prev" type="button" data-lb="prev" aria-label="Previous figure">‹</button>
    <button class="lb-nav lb-next" type="button" data-lb="next" aria-label="Next figure">›</button>
    <figure>
      <div class="lb-mat">
        <img id="lb-img" alt="" />
        <p class="lb-exif" id="lb-exif" hidden></p>
      </div>
      <figcaption>
        <h3 id="lb-title"></h3>
        <p id="lb-cap"></p>
        <a id="lb-src" href="#"></a>
        <button class="lb-info" id="lb-info" type="button" aria-pressed="false" title="Camera data (i)">i</button>
      </figcaption>
    </figure>
  </dialog>
</BaseLayout>

<style>
  .gallery-title {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    margin-bottom: 14px;
  }
  .lead {
    max-width: 60ch;
    color: var(--ink-soft);
    font-size: 1.05rem;
    margin: 0 0 26px;
  }
  /* masonry via columns: figures keep their native aspect ratio */
  .gal-grid {
    columns: 3 300px;
    column-gap: 20px;
  }
  .licence {
    margin-top: 28px;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .lightbox {
    width: min(1100px, 94vw);
    max-height: 94vh;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 13px;
    background: var(--panel);
    color: var(--ink);
    overflow: auto;
  }
  .lightbox::backdrop { background: rgba(15, 15, 12, 0.82); }
  .lightbox figure { margin: 0; }
  .lb-mat {
    background: #fcfcfa;
    padding: 22px;
    display: flex;
    justify-content: center;
  }
  .lb-mat { position: relative; }
  /* mock camera data (easter egg), toggled with i */
  .lb-exif {
    position: absolute;
    left: 50%;
    bottom: 10px;
    transform: translateX(-50%);
    max-width: calc(100% - 20px);
    margin: 0;
    padding: 4px 12px;
    border-radius: 4px;
    background: rgba(20, 20, 16, 0.78);
    color: #f5f4ec;
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    text-align: center;
  }
  .lb-exif[hidden] { display: none; }
  .lightbox figcaption { position: relative; }
  .lb-info {
    position: absolute;
    right: 14px;
    bottom: 14px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1px solid var(--rule);
    background: transparent;
    color: var(--muted);
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.8rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0.6;
  }
  .lb-info:hover, .lb-info[aria-pressed='true'] { opacity: 1; color: var(--gold); border-color: var(--gold); }
  .lb-mat img {
    max-width: 100%;
    max-height: 72vh;
    object-fit: contain;
  }
  .lightbox figcaption { padding: 16px 22px 20px; }
  .lightbox h3 {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.3rem;
    margin: 0 0 6px;
  }
  #lb-cap { color: var(--ink-soft); margin: 0 0 10px; max-width: 70ch; }
  #lb-src { font-family: var(--mono); font-size: 0.78rem; color: var(--teal); }
  .lb-close, .lb-nav {
    position: absolute;
    z-index: 1;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--rule);
    background: var(--panel);
    color: var(--ink);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }
  .lb-close { top: 10px; right: 10px; }
  .lb-nav { top: calc(36vh - 20px); }
  .lb-prev { left: 10px; }
  .lb-next { right: 10px; }
  @media (max-width: 560px) {
    .lb-mat { padding: 12px; }
    .lb-nav { top: auto; bottom: 12px; }
  }
</style>

<script>
  import { unlock, remember, record } from '@/scripts/eggs';

  const grid = document.getElementById('gal-grid')!;
  const cards = [...grid.querySelectorAll<HTMLElement>('.card')];

  // Lightbox: steps through the currently visible cards only.
  const lb = document.getElementById('lightbox') as HTMLDialogElement;
  const lbImg = document.getElementById('lb-img') as HTMLImageElement;
  const lbTitle = document.getElementById('lb-title')!;
  const lbCap = document.getElementById('lb-cap')!;
  const lbSrc = document.getElementById('lb-src') as HTMLAnchorElement;
  const lbExif = document.getElementById('lb-exif')!;
  const lbInfo = document.getElementById('lb-info') as HTMLButtonElement;
  const total = Number(grid.dataset.total);
  let current = 0;
  let exifOn = false;
  const visible = () => cards.filter((c) => !c.hidden);

  function setExif(on: boolean) {
    exifOn = on && !!lbExif.textContent;
    lbExif.hidden = !exifOn;
    lbInfo.setAttribute('aria-pressed', String(exifOn));
    if (exifOn) unlock('exif');
  }

  function show(card: HTMLElement) {
    const img = card.querySelector('img')!;
    const src = card.querySelector<HTMLAnchorElement>('a.src');
    lbImg.src = img.src;
    lbImg.alt = img.alt;
    lbTitle.textContent = card.querySelector('h3')!.textContent;
    lbCap.textContent = card.querySelector('.cap')!.textContent;
    lbSrc.hidden = !src;
    if (src) {
      lbSrc.href = src.href;
      lbSrc.textContent = `From: ${src.title}`;
    }
    current = visible().indexOf(card);
    lbExif.textContent = card.dataset.exif ?? '';
    lbInfo.hidden = !card.dataset.exif;
    setExif(exifOn);
    // every piece opened counts towards "Curator"
    record('gallery-total', total);
    if (remember('gallery', card.id) >= total) unlock('curator');
  }
  function step(d: number) {
    const v = visible();
    show(v[(current + d + v.length) % v.length]);
  }

  grid.addEventListener('click', (ev) => {
    const trigger = (ev.target as HTMLElement).closest('[data-lightbox]');
    if (!trigger) return;
    show(trigger.closest<HTMLElement>('.card')!);
    lb.showModal();
  });
  lb.addEventListener('click', (ev) => {
    const t = ev.target as HTMLElement;
    const action = t.closest<HTMLElement>('[data-lb]')?.dataset.lb;
    if (action === 'close' || t === lb) lb.close();
    else if (action === 'prev') step(-1);
    else if (action === 'next') step(1);
    else if (t.closest('#lb-info')) setExif(!exifOn);
  });
  lb.addEventListener('keydown', (ev) => {
    if (ev.key === 'ArrowLeft') step(-1);
    else if (ev.key === 'ArrowRight') step(1);
    else if (ev.key.toLowerCase() === 'i' && !ev.ctrlKey && !ev.metaKey && !ev.altKey) setExif(!exifOn);
  });
</script>
