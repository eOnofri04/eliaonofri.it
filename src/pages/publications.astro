---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PubEntry from '@/components/PubEntry.astro';
import FacetFilters from '@/components/FacetFilters.astro';
import { getSections, getPublications, CORR_ICON } from '@/lib/bib';
import { usedFacets } from '@/lib/taxonomy';

const sections = getSections();
const all = getPublications();
const total = all.length;
const facets = usedFacets(all.map((p) => p.cls));

// the d20 (easter egg): a natural 1 lands on the oldest thesis, a natural 20 on CRIT_SUCCESS
// (a bib key; empty means the first entry of the list)
const CRIT_SUCCESS = '';
const theses = sections.find((s) => s.type === 'thesis')?.items ?? [];
const critFail = [...theses].sort((a, b) => (a.year ?? 0) - (b.year ?? 0))[0]?.key ?? '';
const critSuccess = CRIT_SUCCESS || sections[0]?.items[0]?.key || '';

// continuous [n] numbering across sections, in display order
let n = 0;
const numbered = sections.map((s) => ({
  ...s,
  items: s.items.map((p) => ({ ...p, idx: ++n })),
}));
---
<BaseLayout
  depth
  title="Publications"
  description="Publications by Elia Onofri — cryptography, graph theory, numerical modelling, and machine learning."
>
  <div class="wrap page-body">
    <p class="eyebrow">Publications</p>
    <h1>Publications</h1>
    <p class="lead">
      {total} entries, rendered from the same <code>.bib</code> maintained for my CV. Filter by field and application, or browse the
      full list grouped by type — or explore the <a href="/statistics">collaboration network</a>.
      <Fragment set:html={CORR_ICON} /> marks the corresponding author.
    </p>

    <FacetFilters target="pub-list" fields={facets.fields} apps={facets.apps} />

    <div class="d20-row">
      <button class="d20" id="d20" type="button" data-fail={critFail} data-success={critSuccess}
        aria-label="Roll a d20 for a random paper" title="Roll for a random paper">
        <svg viewBox="0 0 40 40" aria-hidden="true">
          <path class="d20-edge" d="M20 2 L35.6 11 L35.6 29 L20 38 L4.4 29 L4.4 11 Z" />
          <path class="d20-face" d="M20 10 L28.7 25 L11.3 25 Z" />
          <path class="d20-edge" d="M20 10 L20 2 M20 10 L4.4 11 M20 10 L35.6 11 M28.7 25 L35.6 11 M28.7 25 L35.6 29 M28.7 25 L20 38 M11.3 25 L4.4 11 M11.3 25 L4.4 29 M11.3 25 L20 38" />
          <text x="20" y="22.6" text-anchor="middle" id="d20-num">20</text>
        </svg>
      </button>
      <span class="d20-out" id="d20-out" aria-live="polite"></span>
    </div>

    <div id="pub-list">
      {numbered.map((s) => (
        <section class="pub-section" data-section>
          <h2 class="sec-title">{s.label} <span class="sec-count">{s.items.length}</span></h2>
          {s.items.map((p) => (
            <PubEntry
              id={p.key}
              idx={p.idx}
              authorsHtml={p.authorsHtml}
              title={p.title}
              venue={p.venue}
              year={p.year}
              note={p.note}
              cls={p.cls}
              links={p.links}
            />
          ))}
        </section>
      ))}
    </div>
    <p class="empty" id="pub-list-empty" hidden>No publications match this combination.</p>
  </div>
</BaseLayout>


<script>
  import { unlock } from '@/scripts/eggs';

  const die = document.getElementById('d20') as HTMLButtonElement;
  const num = document.getElementById('d20-num')!;
  const out = document.getElementById('d20-out')!;
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  die.addEventListener('click', () => {
    if (die.classList.contains('rolling')) return;
    const r = 1 + Math.floor(Math.random() * 20);
    die.classList.add('rolling');
    out.textContent = '';
    const flick = window.setInterval(() => { num.textContent = String(1 + Math.floor(Math.random() * 20)); }, 60);
    window.setTimeout(() => {
      window.clearInterval(flick);
      die.classList.remove('rolling');
      num.textContent = String(r);
      land(r);
    }, still ? 0 : 700);
  });

  function land(r: number) {
    const shown = [...document.querySelectorAll<HTMLElement>('#pub-list .pub')].filter((p) => !p.hidden && !p.closest('[hidden]'));
    if (!shown.length) return;
    const pick = (key?: string) => shown.find((p) => p.id === key) ?? shown[Math.floor(Math.random() * shown.length)];
    const target = r === 1 ? pick(die.dataset.fail) : r === 20 ? pick(die.dataset.success) : pick();
    out.textContent = r === 20 ? 'Natural 20: critical success!' : r === 1 ? 'Natural 1: critical fail.' : `Rolled ${r}.`;
    target.scrollIntoView({ block: 'center', behavior: still ? 'auto' : 'smooth' });
    target.classList.remove('rolled');
    void target.offsetWidth;
    target.classList.add('rolled');
    unlock('initiative');
    if (r === 1) unlock('nat1');
    if (r === 20) unlock('nat20');
  }
</script>

<style>
  .d20-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: -12px 0 22px;
  }
  .d20 {
    width: 38px;
    height: 38px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    color: var(--muted);
  }
  .d20:hover { color: var(--gold); }
  .d20 svg { width: 100%; height: 100%; display: block; overflow: visible; }
  .d20-edge { fill: none; stroke: currentColor; stroke-width: 1.3; stroke-linejoin: round; }
  .d20-face { fill: color-mix(in srgb, currentColor 14%, transparent); stroke: currentColor; stroke-width: 1.3; stroke-linejoin: round; }
  .d20 text { fill: currentColor; font-family: var(--mono); font-size: 7.5px; font-weight: 700; }
  .d20.rolling svg { animation: roll 0.7s cubic-bezier(0.3, 0.7, 0.4, 1); }
  @keyframes roll {
    from { transform: rotate(0) scale(1); }
    50% { transform: rotate(400deg) scale(1.15); }
    to { transform: rotate(720deg) scale(1); }
  }
  .d20-out { font-family: var(--mono); font-size: 0.78rem; color: var(--muted); }
  @media (prefers-reduced-motion: reduce) {
    .d20.rolling svg { animation: none; }
  }

  .eyebrow {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 6px;
  }
  h1 { font-size: clamp(2rem, 4vw, 2.8rem); margin: 0 0 14px; }
  .lead {
    color: var(--ink-soft);
    max-width: 62ch;
    line-height: 1.6;
    margin: 0 0 26px;
  }
  .lead code {
    font-family: var(--mono);
    font-size: 0.85em;
    background: var(--panel-2);
    padding: 1px 5px;
    border-radius: 4px;
  }
  .lead a { color: var(--teal); }
  .lead a:hover { text-decoration: underline; }
  .pub-section { margin-bottom: 40px; }
  .sec-title {
    font-family: var(--serif);
    font-size: 1.3rem;
    color: var(--ink);
    margin: 0 0 6px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--rule);
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .sec-count {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--muted);
    font-weight: 400;
  }
  .empty { color: var(--muted); font-family: var(--mono); font-size: 0.9rem; }
</style>
