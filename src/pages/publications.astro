---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PubEntry from '@/components/PubEntry.astro';
import FacetFilters from '@/components/FacetFilters.astro';
import { getSections, getPublications, CORR_ICON } from '@/lib/bib';
import { usedFacets } from '@/lib/taxonomy';

const sections = getSections();
const all = getPublications();
const total = all.length;
const facets = usedFacets(all.map((p) => p.cls));

// continuous [n] numbering across sections, in display order
let n = 0;
const numbered = sections.map((s) => ({
  ...s,
  items: s.items.map((p) => ({ ...p, idx: ++n })),
}));
---
<BaseLayout
  title="Publications"
  description="Publications by Elia Onofri — cryptography, graph theory, numerical modelling, and machine learning."
>
  <div class="wrap page-body">
    <p class="eyebrow">Publications</p>
    <h1>Publications</h1>
    <p class="lead">
      {total} entries, rendered from the same <code>.bib</code> maintained for my CV. Filter by field and application, or browse the
      full list grouped by type — or explore the <a href="/statistics">collaboration network</a>.
      <Fragment set:html={CORR_ICON} /> marks the corresponding author.
    </p>

    <FacetFilters target="pub-list" fields={facets.fields} apps={facets.apps} />

    <div id="pub-list">
      {numbered.map((s) => (
        <section class="pub-section" data-section>
          <h2 class="sec-title">{s.label} <span class="sec-count">{s.items.length}</span></h2>
          {s.items.map((p) => (
            <PubEntry
              id={p.key}
              idx={p.idx}
              authorsHtml={p.authorsHtml}
              title={p.title}
              venue={p.venue}
              year={p.year}
              note={p.note}
              cls={p.cls}
              links={p.links}
            />
          ))}
        </section>
      ))}
    </div>
    <p class="empty" id="pub-list-empty" hidden>No publications match this combination.</p>
  </div>
</BaseLayout>


<style>
  .eyebrow {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 6px;
  }
  h1 { font-size: clamp(2rem, 4vw, 2.8rem); margin: 0 0 14px; }
  .lead {
    color: var(--ink-soft);
    max-width: 62ch;
    line-height: 1.6;
    margin: 0 0 26px;
  }
  .lead code {
    font-family: var(--mono);
    font-size: 0.85em;
    background: var(--panel-2);
    padding: 1px 5px;
    border-radius: 4px;
  }
  .lead a { color: var(--teal); }
  .lead a:hover { text-decoration: underline; }
  .pub-section { margin-bottom: 40px; }
  .sec-title {
    font-family: var(--serif);
    font-size: 1.3rem;
    color: var(--ink);
    margin: 0 0 6px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--rule);
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .sec-count {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--muted);
    font-weight: 400;
  }
  .empty { color: var(--muted); font-family: var(--mono); font-size: 0.9rem; }
</style>
