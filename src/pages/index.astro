---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HighlightCard from '@/components/HighlightCard.astro';
import Chip from '@/components/Chip.astro';
import { affiliations, linkify } from '@/data/affiliations';
import { highlights, researchAreas } from '@/data/highlights';
const primary = affiliations.filter(a => a.primary);
const secondary = affiliations.filter(a => !a.primary);

// identifier row: logos on theme-coloured tiles; `dark` marks logos with a light variant
// (`<logo>-dark.webp`) for the dark theme. Math Genealogy and e-mail use inline glyphs.
const ids = [
  { label: 'ORCID',            href: 'https://orcid.org/0000-0001-8391-2563', logo: 'orcid' },
  { label: 'Google Scholar',   href: 'https://scholar.google.com/citations?user=7IAjzlEAAAAJ', logo: 'scholar' },
  { label: 'Scopus',           href: 'https://www.scopus.com/authid/detail.uri?authorId=57215199778', logo: 'scopus' },
  { label: 'Web of Science',   href: 'https://www.webofscience.com/wos/author/record/AAA-8888-2022', logo: 'wos', dark: true },
  { label: 'Semantic Scholar', href: 'https://www.semanticscholar.org/author/Elia-Onofri/1389066185', logo: 'semanticscholar', dark: true },
  { label: 'ResearchGate',     href: 'https://www.researchgate.net/profile/Elia-Onofri', logo: 'researchgate' },
  { label: 'GitHub',           href: 'https://github.com/eOnofri04', logo: 'github', dark: true },
  { label: 'LinkedIn',         href: 'https://www.linkedin.com/in/elia-onofri-80b403173/', logo: 'linkedin' },
  { label: 'YouTube',          href: 'https://www.youtube.com/@eliaonofri7623', logo: 'youtube' },
  { label: 'Mathematics Genealogy Project', href: 'https://www.mathgenealogy.org/id.php?id=307607', glyph: 'tree' },
  { label: 'E-mail',           href: 'mailto:elia.onofri@kaust.edu.sa', glyph: 'mail' },
];

// Erdős-number chain, linked where a page exists
const erdos = [
  { name: 'Erdős',    href: 'https://scholar.google.com/citations?user=cVeVZ1YAAAAJ&hl=en' },
  { name: 'Komornik', href: 'https://irma.math.unistra.fr/~komornik/index.html' },
  { name: 'Pedicini', href: 'https://www.mat.uniroma3.it/users/pedicini/' },
  { name: 'Onofri' },
];
---
<BaseLayout
  title="Home"
  description="Elia Onofri — Postdoctoral Researcher in Cryptography, Graph Theory, and Numerical Modelling. KAUST · CNR · Roma Tre."
>
  <div class="wrap page-body">

    <!-- ── Hero ── -->
    <section class="hero">
      <div class="hero-text">
        <h1>Elia Onofri</h1>

        {primary.map(a => (
          <p class="primary-affil">
            <span class="primary-role">{linkify(a.role, a.links).map(seg => seg.href
              ? <a href={seg.href} target="_blank" rel="noopener">{seg.text}</a>
              : seg.text)}</span>
            {a.url
              ? <a href={a.url} target="_blank" rel="noopener" class="primary-org">{a.org}</a>
              : <span class="primary-org">{a.org}</span>
            }
          </p>
        ))}

        <p class="lede">
          Cryptography, security, artificial intelligence, graph theory, and numerical modelling — with a recurring
          interest in turning mathematical structure into something you can see.
        </p>

        <ul class="affils" role="list">
          {secondary.map(a => (
            <li class={`affil affil--${a.color}`}>
              <strong>{a.role}</strong>
              {a.url && !a.links
                ? <a href={a.url} target="_blank" rel="noopener" class="org">{a.org}</a>
                : <span class="org">{linkify(a.org, a.links).map(seg => seg.href
                    ? <a href={seg.href} target="_blank" rel="noopener">{seg.text}</a>
                    : seg.text)}</span>
              }
            </li>
          ))}
        </ul>

        <p class="erdos">My Erdős number is <strong>3</strong> &mdash; {erdos.map((p, i) => (
          <>{i > 0 && ' · '}{p.href ? <a href={p.href} target="_blank" rel="noopener">{p.name}</a> : p.name}</>
        ))}</p>

        <div class="id-row">
          {ids.map(i => (
            <a href={i.href} title={i.label} aria-label={i.label}
              {...(i.href.startsWith('mailto:') ? {} : { target: '_blank', rel: 'noopener' })}>
              {i.logo && <img class={i.dark ? 'logo-light' : undefined} src={`/logos/${i.logo}.webp`} alt="" width="22" height="22" loading="lazy" />}
              {i.dark && <img class="logo-dark" src={`/logos/${i.logo}-dark.webp`} alt="" width="22" height="22" loading="lazy" />}
              {i.glyph === 'tree' && (
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                  <circle cx="12" cy="4.5" r="2.2" /><circle cx="5.5" cy="19" r="2.2" /><circle cx="12" cy="19" r="2.2" /><circle cx="18.5" cy="19" r="2.2" />
                  <path d="M12 6.7v10.1M12 11.5H5.5v5.3M12 11.5h6.5v5.3" />
                </svg>
              )}
              {i.glyph === 'mail' && (
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
                  <rect x="3" y="5.5" width="18" height="13" rx="2" /><path d="M3.5 6.5 12 13l8.5-6.5" />
                </svg>
              )}
            </a>
          ))}
        </div>
      </div>

      <figure class="hero-art">
        <div class="art-frame">
          <img
            class="fig-dark"
            src="/figures/fibonacci_dark.svg"
            alt="A Fibonacci-inspired worst-case structure for beta-contraction"
            width="800"
            height="800"
          />
          <img
            class="fig-light"
            src="/figures/fibonacci_light.svg"
            alt="A Fibonacci-inspired worst-case structure for beta-contraction"
            width="800"
            height="800"
          />
        </div>
        <figcaption>A Fibonacci-inspired worst-case structure for beta-contraction</figcaption>
      </figure>
    </section>

    <!-- ── Currently ── -->
    <section class="strip" aria-labelledby="currently-heading">
      <h2 class="sec-title" id="currently-heading">Currently</h2>
      <div class="hl-grid">
        {highlights.map(h => (
          <HighlightCard kind={h.kind} date={h.date} color={h.color} href={h.href}>
            <span slot="title">{h.title}</span>
            <span slot="detail">{h.detail}</span>
          </HighlightCard>
        ))}
      </div>
    </section>

    <!-- ── Research areas ── -->
    <section class="areas" aria-labelledby="areas-heading">
      <h2 class="sec-title" id="areas-heading">Research areas</h2>
      <div class="chips">
        {researchAreas.map(a => (
          <Chip color={a.color}>{a.label}</Chip>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  /* hero layout */
  .hero {
    display: grid;
    grid-template-columns: 1.25fr 0.9fr;
    gap: 54px;
    align-items: center;
    padding-bottom: 18px;
  }

  h1 {
    font-size: clamp(2.5rem, 5.5vw, 3.9rem);
    margin: 0 0 4px;
  }

  /* primary affiliation — beneath name, no bullet */
  .primary-affil {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0 0 20px;
  }
  .primary-role {
    font-size: 1.18rem;
    font-weight: 600;
    color: var(--ink-soft);
    line-height: 1.3;
  }
  .primary-org {
    font-family: var(--mono);
    font-size: 0.88rem;
    color: var(--muted);
    transition: color 0.18s;
  }
  a.primary-org:hover { color: var(--teal); }

  .lede {
    font-size: 1.12rem;
    color: var(--ink-soft);
    max-width: 48ch;
    margin: 0 0 26px;
    line-height: 1.55;
  }

  /* secondary affiliations list */
  .affils {
    list-style: none;
    margin: 0 0 26px;
    padding: 0;
    display: grid;
    gap: 9px;
  }
  .affil {
    padding-left: 20px;
    position: relative;
    font-size: 0.92rem;
    color: var(--muted);
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .affil::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 7px;
    height: 7px;
    border-radius: 2px;
  }
  .affil--teal::before   { background: var(--teal); }
  .affil--terra::before  { background: var(--terra); }
  .affil--gold::before   { background: var(--gold); }
  .affil--purple::before { background: var(--purple); }

  .affil strong {
    font-weight: 600;
    color: var(--ink-soft);
    font-size: inherit;
  }
  .org {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--muted);
    transition: color 0.18s;
  }
  a.org:hover { color: var(--teal); }

  .erdos {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--muted);
    margin: 0 0 18px;
  }
  .erdos strong { color: var(--teal); font-weight: 600; }

  .primary-role a, .org a, .erdos a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 3px;
    transition: color 0.18s, text-decoration-color 0.18s;
  }
  .primary-role a:hover, .org a:hover, .erdos a:hover { color: var(--teal); text-decoration-color: var(--teal); }

  /* identifier row: logos on tiles in the template's panel colour */
  .id-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .id-row a {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 9px;
    background: var(--panel-2);
    border: 1px solid var(--rule);
    color: var(--ink-soft);
    transition: transform 0.18s, border-color 0.18s, box-shadow 0.18s;
  }
  .id-row a:hover {
    transform: translateY(-2px);
    border-color: var(--teal);
    box-shadow: 0 0 0 1px var(--teal);
  }
  .id-row img { display: block; width: 22px; height: 22px; object-fit: contain; }
  /* dark is the default theme; light is opted into via data-theme */
  :global(:root[data-theme='light']) .id-row .logo-dark { display: none; }
  :global(:root:not([data-theme='light'])) .id-row .logo-light { display: none; }

  /* hero artwork */
  .hero-art {
    align-self: start;
    margin: 0;
  }
  .art-frame {
    background: var(--panel);
    border: 1px solid var(--rule);
    border-radius: 14px;
    padding: 18px;
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .art-frame img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 4px;
  }
  /* theme-aware figure swap — pure CSS, no flash */
  :global(:root[data-theme='dark'])  .fig-light { display: none; }
  :global(:root[data-theme='light']) .fig-dark  { display: none; }
  :global(:root:not([data-theme='light'])) .fig-light { display: none; }
  .hero-art figcaption {
    font-family: var(--mono);
    font-size: 0.74rem;
    color: var(--muted);
    margin-top: 12px;
    text-align: center;
    letter-spacing: 0.02em;
  }

  /* currently strip */
  .strip { margin-top: 64px; }
  .hl-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  /* research areas */
  .areas { margin-top: 62px; }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }

  /* responsive */
  @media (max-width: 880px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 34px;
    }
    .hero-art { max-width: 360px; }
  }

  @media (max-width: 640px) {
    .hl-grid { grid-template-columns: 1fr; }
  }
</style>
