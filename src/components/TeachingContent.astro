---
import { teaching, students } from '@/data/teaching';

interface Props { lang: 'en' | 'it'; }
const { lang } = Astro.props;

const T = {
  en: {
    lead: 'Courses, supplementary teaching, and tutoring at Roma Tre University and the Master in Data Analytics — with the students I have supervised.',
    students: 'Students',
    studentsLead: 'Theses supervised, most recent first.',
    current: 'in progress',
    thesis: 'Thesis',
    cosup: 'Co-supervisor',
    tbd: 'title to be defined',
  },
  it: {
    lead: 'Corsi, didattica integrativa e tutoraggio presso l’Università Roma Tre e il Master in Data Analytics — con gli studenti di cui sono stato relatore.',
    students: 'Studenti',
    studentsLead: 'Tesi seguite, dalla più recente.',
    current: 'in corso',
    thesis: 'Tesi',
    cosup: 'Relatore interno',
    tbd: 'titolo da definire',
  },
}[lang];

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const MESI = ['Gen', 'Feb', 'Mar', 'Apr', 'Mag', 'Giu', 'Lug', 'Ago', 'Set', 'Ott', 'Nov', 'Dic'];
const fmt = (iso: string) => {
  if (iso === 'current') return T.current;
  const [y, m, d] = iso.split('-');
  return `${+d} ${(lang === 'it' ? MESI : MONTHS)[+m - 1]} ${y}`;
};
const sortedStudents = [...students].sort((a, b) => {
  if (a.date === 'current') return -1;
  if (b.date === 'current') return 1;
  return b.date.localeCompare(a.date);
});
---
<p class="lead">{T.lead}</p>

{teaching.map((g) => (
  <section class="tgroup">
    <header class="tgroup-head">
      <h2 class="tgroup-kind">{g.kind[lang]}</h2>
      <span class="tgroup-meta">{g.org[lang]} · {g.period}</span>
    </header>
    <ul class="course-list" role="list">
      {g.courses.map((c) => (
        <li class="course">
          <span class="course-year">{c.year}</span>
          <div class="course-body">
            <p class="course-name">
              {c.code && <span class="course-code">{c.code}</span>}
              {c.name[lang]}
              {c.ssd && <span class="course-ssd">{c.ssd}</span>}
            </p>
            <span class="course-prog">{c.programme}</span>
          </div>
        </li>
      ))}
    </ul>
  </section>
))}

<section id="students" class="tgroup students">
  <header class="tgroup-head">
    <h2 class="tgroup-kind">{T.students}</h2>
    <span class="tgroup-meta">{T.studentsLead}</span>
  </header>
  <ul class="stud-list" role="list">
    {sortedStudents.map((s) => (
      <li class={`stud${s.date === 'current' ? ' stud--current' : ''}`}>
        <span class="stud-date">{fmt(s.date)}</span>
        <div class="stud-body">
          <p class="stud-name">{s.name}</p>
          <p class="stud-degree">{s.degree[lang]}</p>
          <p class="stud-thesis">
            {s.thesis
              ? <><span class="stud-label">{T.thesis}:</span> <em>{s.thesis}</em></>
              : <span class="stud-tbd">{T.thesis}: {T.tbd}</span>}
            {s.coSupervisor && <span class="stud-cosup"> · {T.cosup}: {s.coSupervisor}</span>}
          </p>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .lead { color: var(--ink-soft); max-width: 64ch; line-height: 1.6; margin: 0 0 32px; }

  .tgroup { margin-bottom: 38px; }
  .tgroup-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 12px;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--rule);
  }
  .tgroup-kind { font-family: var(--serif); font-size: 1.35rem; color: var(--ink); margin: 0; }
  .tgroup-meta { font-family: var(--mono); font-size: 0.78rem; color: var(--muted); }

  .course-list { list-style: none; margin: 0; padding: 0; }
  .course {
    display: grid;
    grid-template-columns: 9em 1fr;
    gap: 2px 14px;
    padding: 9px 0 9px 14px;
    border-left: 2px solid var(--rule);
    transition: border-color 0.18s;
  }
  .course:hover { border-left-color: var(--teal); }
  .course-year { font-family: var(--mono); font-size: 0.78rem; color: var(--muted); padding-top: 1px; }
  .course-body { display: flex; flex-direction: column; gap: 2px; }
  .course-name { font-family: var(--serif); font-size: 1rem; color: var(--ink); margin: 0; }
  .course-code {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--teal);
    margin-right: 8px;
  }
  .course-ssd { font-family: var(--mono); font-size: 0.72rem; color: var(--muted); margin-left: 8px; }
  .course-prog { font-family: var(--mono); font-size: 0.74rem; color: var(--muted); }

  /* students */
  .stud-list { list-style: none; margin: 0; padding: 0; }
  .stud {
    display: grid;
    grid-template-columns: 9em 1fr;
    gap: 2px 14px;
    padding: 12px 0 12px 14px;
    border-left: 2px solid var(--rule);
    transition: border-color 0.18s;
  }
  .stud:hover { border-left-color: var(--gold); }
  .stud--current { border-left-color: var(--gold); }
  .stud-date { font-family: var(--mono); font-size: 0.78rem; color: var(--muted); padding-top: 2px; }
  .stud-name { font-family: var(--serif); font-weight: 700; font-size: 1.05rem; color: var(--ink); margin: 0; }
  .stud-degree { font-family: var(--mono); font-size: 0.76rem; color: var(--muted); margin: 1px 0 5px; }
  .stud-thesis { font-size: 0.9rem; color: var(--ink-soft); line-height: 1.45; margin: 0; }
  .stud-thesis em { font-style: italic; }
  .stud-label { color: var(--muted); }
  .stud-tbd { color: var(--muted); font-style: italic; }
  .stud-cosup { font-family: var(--mono); font-size: 0.74rem; color: var(--muted); }

  @media (max-width: 640px) {
    .course, .stud { grid-template-columns: 1fr; }
    .course-year, .stud-date { padding-top: 0; }
  }
</style>
