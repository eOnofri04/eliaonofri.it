---
interface Props {
  type: 'network' | 'spiral' | 'field' | 'cube' | 'crowd' | 'tree';
  seed?: number;
  label?: string;
}
const { type, seed, label } = Astro.props;
---
<figure class="art-figure">
  <div class="art-frame">
    <svg data-art={type} data-seed={seed} viewBox="0 0 400 400" aria-hidden="true"></svg>
  </div>
  {label && <figcaption>{label}</figcaption>}
</figure>

<style>
  .art-figure {
    margin: 0;
    position: relative;
  }
  .art-frame {
    background: var(--panel);
    border: 1px solid var(--rule);
    border-radius: 14px;
    padding: 18px;
    box-shadow: var(--shadow);
    position: relative;
    overflow: hidden;
  }
  .art-frame svg {
    width: 100%;
    height: auto;
    display: block;
  }
  figcaption {
    font-family: var(--mono);
    font-size: 0.74rem;
    color: var(--muted);
    margin-top: 12px;
    text-align: center;
    letter-spacing: 0.02em;
  }
</style>

<script>
  /* procedural artwork renderer — ported from the design mock */
  (function () {
    const NS = 'http://www.w3.org/2000/svg';
    const el = (t: string, a: Record<string, string | number>) => {
      const e = document.createElementNS(NS, t);
      for (const k in a) e.setAttribute(k, String(a[k]));
      return e;
    };

    function rng(seed: number) {
      let s = seed | 0;
      return () => {
        s = (s + 0x6d2b79f5) | 0;
        let t = Math.imul(s ^ (s >>> 15), 1 | s);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }

    const CLS = ['art-a', 'art-b', 'art-c'];

    function network(svg: SVGSVGElement, seed: number) {
      const r = rng(seed || 7);
      const N = 14;
      const P: { x: number; y: number }[] = [];
      for (let i = 0; i < N; i++) P.push({ x: 46 + r() * 308, y: 46 + r() * 308 });
      for (let i = 0; i < N; i++) {
        const d = P.map((p, j) => ({ j, d: (p.x - P[i].x) ** 2 + (p.y - P[i].y) ** 2 })).sort((a, b) => a.d - b.d);
        for (let m = 1; m <= 2; m++) {
          const j = d[m].j;
          if (j > i) svg.appendChild(el('line', { x1: P[i].x, y1: P[i].y, x2: P[j].x, y2: P[j].y, class: 'art-edge' }));
        }
      }
      P.forEach((p, i) => svg.appendChild(el('circle', { cx: p.x, cy: p.y, r: 5 + (i % 3) * 2.4, class: CLS[i % 3] })));
    }

    function spiral(svg: SVGSVGElement) {
      const cx = 200, cy = 200, b = 0.2;
      let d = '';
      for (let t = 0; t <= 6.6 * Math.PI; t += 0.1) {
        const rr = 2.4 * Math.exp(b * t);
        const x = cx + rr * Math.cos(t);
        const y = cy + rr * Math.sin(t);
        d += (t ? 'L' : 'M') + x.toFixed(1) + ' ' + y.toFixed(1) + ' ';
      }
      svg.appendChild(el('path', { d, class: 'art-spiral' }));
      for (let t = 0; t <= 6.6 * Math.PI; t += Math.PI / 2) {
        const rr = 2.4 * Math.exp(b * t);
        svg.appendChild(el('circle', { cx: cx + rr * Math.cos(t), cy: cy + rr * Math.sin(t), r: 3, class: 'art-c' }));
      }
    }

    function field(svg: SVGSVGElement) {
      for (let x = 40; x <= 360; x += 40)
        for (let y = 40; y <= 360; y += 40)
          svg.appendChild(el('circle', { cx: x, cy: y, r: 1.4, class: 'art-grid' }));
      for (let k = 8; k >= 1; k--) {
        const e = el('ellipse', { cx: 200, cy: 200, rx: 20 * k, ry: 15 * k, class: 'art-field' });
        (e as SVGElement).style.opacity = (0.25 + k * 0.085).toFixed(2);
        e.setAttribute('transform', `rotate(${k * 7} 200 200)`);
        svg.appendChild(e);
      }
      svg.appendChild(el('circle', { cx: 200, cy: 200, r: 5, class: 'art-a' }));
    }

    function cube(svg: SVGSVGElement) {
      const sq = (pts: number[][], cls: string) =>
        svg.appendChild(el('polygon', { points: pts.map(q => q.join(',')).join(' '), class: cls, fill: 'none' }));
      const O = [[80, 80], [320, 80], [320, 320], [80, 320]];
      const I = [[150, 150], [250, 150], [250, 250], [150, 250]];
      for (let i = 0; i < 4; i++)
        svg.appendChild(el('line', { x1: O[i][0], y1: O[i][1], x2: I[i][0], y2: I[i][1], class: 'art-edge' }));
      sq(O, 'art-line'); sq(I, 'art-line-2');
      const M = [[115, 115], [285, 115], [285, 285], [115, 285]]; sq(M, 'art-edge');
      [...O, ...I].forEach((p, i) => svg.appendChild(el('circle', { cx: p[0], cy: p[1], r: 3.5, class: CLS[i % 3] })));
    }

    function crowd(svg: SVGSVGElement) {
      const r = rng(11);
      for (let i = 0; i < 46; i++)
        svg.appendChild(el('circle', { cx: 30 + r() * 340, cy: 30 + r() * 340, r: 1.8, class: 'art-dim' }));
      const paths: [string, string][] = [
        ['M40 320 C140 240 180 120 360 80', 'art-traj-a'],
        ['M60 80 C160 180 220 260 340 300', 'art-traj-b'],
        ['M40 180 C160 120 240 240 360 200', 'art-traj-a'],
      ];
      paths.forEach(([d, c]) => {
        svg.appendChild(el('path', { d, class: c }));
        const m = d.match(/M(\d+) (\d+)/);
        if (m) svg.appendChild(el('circle', { cx: +m[1], cy: +m[2], r: 4, class: 'art-hot' }));
      });
    }

    function tree(svg: SVGSVGElement) {
      function node(x: number, y: number, dx: number, depth: number) {
        svg.appendChild(el('circle', { cx: x, cy: y, r: depth ? 4.5 : 6, class: depth ? CLS[depth % 3] : 'art-a' }));
        if (depth >= 3) return;
        const ny = y + 85;
        [-1, 1].forEach(s => {
          const nx = x + s * dx;
          svg.appendChild(el('line', { x1: x, y1: y, x2: nx, y2: ny, class: 'art-edge' }));
          node(nx, ny, dx * 0.52, depth + 1);
        });
      }
      node(200, 46, 95, 0);
    }

    const draw: Record<string, (svg: SVGSVGElement, seed?: number) => void> = {
      network, spiral, field, cube, crowd, tree,
    };

    document.querySelectorAll<SVGSVGElement>('[data-art]').forEach(svg => {
      const type = svg.getAttribute('data-art') ?? '';
      const seed = Number(svg.dataset.seed) || undefined;
      const fn = draw[type];
      if (!fn) return;
      svg.style.cssText = `
        --art-a: var(--teal); --art-b: var(--terra); --art-c: var(--gold);
        --art-edge-c: var(--rule); --art-muted: var(--muted);
      `;
      try { fn(svg, seed); } catch { /* fail quietly per-artwork */ }
    });

    /* shared SVG element styles injected once */
    const style = document.createElementNS(NS, 'style');
    style.textContent = `
      .art-a  { fill: var(--teal) }
      .art-b  { fill: var(--terra) }
      .art-c  { fill: var(--gold) }
      .art-grid { fill: var(--muted); opacity: 0.4 }
      .art-dim  { fill: var(--muted); opacity: 0.5 }
      .art-hot  { fill: var(--terra) }
      .art-edge { fill: none; stroke: var(--rule); stroke-width: 1.4 }
      .art-line { stroke: var(--teal); stroke-width: 1.4 }
      .art-line-2 { stroke: var(--terra); stroke-width: 1.4 }
      .art-spiral { fill: none; stroke: var(--teal); stroke-width: 1.8; opacity: 0.8 }
      .art-field  { fill: none; stroke: var(--teal); stroke-width: 1.2 }
      .art-traj-a { fill: none; stroke: var(--teal); stroke-width: 1.8; opacity: 0.7 }
      .art-traj-b { fill: none; stroke: var(--terra); stroke-width: 1.8; opacity: 0.7 }
    `;
    document.head.appendChild(style);
  })();
</script>
