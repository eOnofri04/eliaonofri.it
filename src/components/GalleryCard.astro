---
// A gallery piece: the figure on a light mat (figures are drawn for white paper,
// so the mat stays light in both themes), then title, caption and provenance.
// Clicking the figure opens the page-level lightbox.
import type { Classification } from '@/lib/taxonomy';

interface Props {
  id: string;
  title: string;
  caption: string;
  alt: string;
  image: string;
  width: number;
  height: number;
  tag: string;
  year: number;
  sourceKey?: string;   // absent for pieces not tied to a paper
  sourceTitle: string;
  cls: Classification;
}
const { id, title, caption, alt, image, width, height, tag, year, sourceKey, sourceTitle, cls } = Astro.props;
---
<article class="card" id={id} data-fields={cls.fields.join(' ')} data-apps={cls.apps.join(' ')}>
  <button class="mat" type="button" data-lightbox aria-label={`Enlarge: ${title}`}>
    <img src={image} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  </button>
  <div class="meta">
    <h3>{title}</h3>
    <p class="cap">{caption}</p>
    <div class="foot">
      <span class="tag">{tag}</span>
      {sourceKey
        ? <a class="src" href={`/publications#${sourceKey}`} title={sourceTitle}>{year || 'in prep.'} ↗</a>
        : year ? <span class="src">{year}</span> : null}
    </div>
  </div>
</article>

<style>
  .card {
    break-inside: avoid;
    margin: 0 0 20px;
    background: var(--panel);
    border: 1px solid var(--rule);
    border-radius: 13px;
    overflow: hidden;
    transition: transform 0.22s, border-color 0.22s, box-shadow 0.22s;
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: var(--rule-soft);
    box-shadow: var(--shadow);
  }
  .mat {
    display: block;
    width: 100%;
    padding: 18px;
    border: 0;
    border-bottom: 1px solid var(--rule);
    background: #fcfcfa;
    cursor: zoom-in;
  }
  .mat img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 520px;
    object-fit: contain;
  }
  .meta {
    padding: 14px 17px 16px;
  }
  h3 {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.12rem;
    margin: 0 0 4px;
  }
  .cap {
    font-size: 0.9rem;
    color: var(--muted);
    margin: 0 0 12px;
    line-height: 1.5;
  }
  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .tag {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--terra);
  }
  .src {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--muted);
    text-decoration: none;
  }
  .src:hover { color: var(--teal); }
</style>
